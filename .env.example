# Copie este arquivo para ".env" e preencha com as suas chaves da Alpaca.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Chaves da conta PAPER (simulada) - painel da Alpaca > Paper > Generate New Keys
ALPACA_API_KEY=cole_aqui_sua_api_key
ALPACA_SECRET_KEY=cole_aqui_sua_secret_key

# PAPER = dinheiro fictício (padrão). LIVE = dinheiro real (exige confirmação no terminal).
MODO=PAPER
